# Copy to .env and fill in one credential. .env is gitignored -- never commit it.
#
# Exactly one credential is needed, plus the model that goes with it. The model
# name must carry the provider prefix litellm routes on, otherwise the key is
# sent to the wrong provider and the failure is an opaque auth error.
#
#   GOOGLE / GEMINI
#   GEMINI_API_KEY=...
#   LLM_MODEL=gemini/gemini-3-flash-preview
#
#   ANTHROPIC
#   ANTHROPIC_API_KEY=...
#   LLM_MODEL=anthropic/claude-sonnet-4-5
#
#   OPENROUTER  (one key, many providers; the prefix is part of the model name)
#   OPENROUTER_API_KEY=...
#   LLM_MODEL=openrouter/anthropic/claude-sonnet-4.5
#
#   OPENAI
#   OPENAI_API_KEY=...
#   LLM_MODEL=gpt-4o
#
# Generic fallbacks, if you would rather not name a provider:
#   LLM_API_KEY=...  /  LITELLM_API_KEY=...  /  SAFI_RCA_LLM_API_KEY=...
#
# Optional:
# SAFI_RCA_TMP_DIR=B:\safi-rca-tmp   # scratch space for git archive exports

# --- example, safe to commit ---
LLM_MODEL=gemini/gemini-3-flash-preview
GEMINI_API_KEY=